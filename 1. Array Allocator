#include <iostream>
#include <string>
using namespace std;

int* createArray(int size)
{
    int* arr = new int[size];
    return arr;
}

int main()
{
    int n;
    
    cout << "Enter the number of elements: ";
    cin >> n;
    
    int* numbers = createArray(n);
    
    for (int i=0; i<n; i++)
    {
        numbers[i] = i+1;
    }
    
    cout << "Array elements: ";
    for (int i=0; i<n; i++)
    {
        cout << numbers[i] << " ";
    }
    
    delete[] numbers;
    return 0;
}
