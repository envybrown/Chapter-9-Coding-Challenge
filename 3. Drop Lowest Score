#include <iostream>
#include <string>
using namespace std;

void sortScores(int* scores, int size)
{
    for (int i=0; i<size-1; i++)
    {
            for (int j=0; j<size-i-1; j++)
            {
            if (*(scores+j)>*(scores+j+1))
            {
                int temp=*(scores+j);
                *(scores+j)=*(scores+j+1);
                *(scores+j+1)=temp;
            }
        }
    }
}

double calcAvg(int* scores, int size)
{
    int sum=0;
    
    for (int i=1; i<size; i++)
    {
        sum+=*(scores+i);
    }
    
    return (double)sum/(size-1);
}

int main()
{
    int numScores;
    
    cout << "How many tests are being scored? ";
    cin >> numScores;
    
    int* scores = new int[numScores];
    
    for (int i=0; i<numScores; i++)
    {
        cout << "Enter score " << i+1 << ": ";
        cin >> *(scores+i);
        
        while(*(scores+i)<0)
        {
            cout << "Invalid input, please try again.\n";
            cin >> *(scores+i);
        }
    }
    
    sortScores(scores, numScores);
    
    double avg=calcAvg(scores, numScores);
    
    cout << "\nSorted test scores:\n";
    for (int i=0; i<numScores; i++)
    {
        cout << *(scores + i) << " ";
    }
    
    cout << "\n\nAverage score: " << avg << endl;
    
    delete[] scores;
    
    return 0;
}
